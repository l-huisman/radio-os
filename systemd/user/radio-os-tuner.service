[Unit]
Description=AM stereo tuner (C-QUAM)
PartOf=graphical-session.target
After=graphical-session.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
ExecStartPre=-/usr/bin/amixer -q -c sndrpihifiberry sset Digital 100%
ExecStart=%h/.local/share/radio/current/build/am_stereo_receiver
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
